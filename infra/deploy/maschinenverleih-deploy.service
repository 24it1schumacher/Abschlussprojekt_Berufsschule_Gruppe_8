[Unit]
Description=Maschinenverleih: neuen Stand von GitHub pruefen und ausrollen
Documentation=file:///srv/maschinenverleih/docs/anleitung_automatisches_deployment.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=maschinenverleih-deploy
Group=maschinenverleih-deploy
SupplementaryGroups=docker
StateDirectory=maschinenverleih-deploy
# Status und Protokoll fuer alle Teammitglieder lesbar (enthalten keine Geheimnisse)
StateDirectoryMode=0755
ExecStart=/bin/bash /srv/maschinenverleih/infra/deploy/auto-update.sh
TimeoutStartSec=20min
# Haertung: Der Dienst darf nur das Repository und sein Statusverzeichnis beschreiben
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/maschinenverleih
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
