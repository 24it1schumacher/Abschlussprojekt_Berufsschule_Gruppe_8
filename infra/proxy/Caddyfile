# Reverse Proxy und Webserver fuer die Maschinenverleih-Anwendung
#
# Ein Eingang fuer alles:
#   /api/*  -> Backend-Container (Spring Boot, Port 8080, nur im internen Netz erreichbar)
#   alles andere -> gebautes Frontend aus /srv
#
# ":80" = reines HTTP. Fuer den VPS mit Domain wird hier spaeter der Domainname eingetragen,
# dann holt Caddy das TLS-Zertifikat automatisch (Story 14 / Issue #18).

{
	# Keine Admin-Schnittstelle nach aussen; Konfiguration kommt nur aus dieser Datei
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Versionsangabe des Webservers nicht verraten
		-Server
	}

	log {
		output stdout
		format console
	}
}
