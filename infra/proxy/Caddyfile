# Reverse Proxy und Webserver fuer die Maschinenverleih-Anwendung
#
# Ein Eingang fuer alles:
#   /api/*  -> Backend-Container (Spring Boot, Port 8080, nur im internen Netz erreichbar)
#   alles andere -> gebautes Frontend aus /srv
#
# SITE_ADDRESS (aus infra/stack/.env):
#   ":80"              lokal, reines HTTP
#   "<hostname>"       auf dem Server: Caddy holt automatisch ein TLS-Zertifikat (Let's Encrypt),
#                      leitet HTTP auf HTTPS um und erneuert das Zertifikat selbst (Issue #18)

{
	# Keine Admin-Schnittstelle; Konfiguration kommt nur aus dieser Datei
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Browser merkt sich: nur noch HTTPS (wird ueber reines HTTP vom Browser ignoriert)
		Strict-Transport-Security "max-age=31536000"
		# Versionsangabe des Webservers nicht verraten
		-Server
	}

	log {
		output stdout
		format console
	}
}
