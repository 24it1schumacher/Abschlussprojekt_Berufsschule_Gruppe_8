# Vorlage. Kopieren:  cp .env.example .env && chmod 600 .env
# Die echte .env wird nie committet (steht in der .gitignore).
# Das Admin-Passwort der Datenbank steht separat in infra/postgres/.env.
# Auf dem Server setzt infra/deploy/install.sh alle Werte automatisch.

# Passwort der Datenbankrolle maschinenverleih_app (aus Anleitung PostgreSQL, Abschnitt 4)
APP_DB_PASSWORD=

# Lokal ":80" (nur HTTP). Server: Hostname, z. B. maschinenverleih.example.de -> automatisches HTTPS
SITE_ADDRESS=:80

# Adresse, unter der die Anwendung im Browser aufgerufen wird (Server: https://<hostname>)
PUBLIC_ORIGIN=http://localhost:8080

# Lokal nur auf dem eigenen Rechner. Server: 0.0.0.0:80 und 0.0.0.0:443
WEB_BIND=127.0.0.1:8080
WEB_TLS_BIND=127.0.0.1:8443

# Mit HTTPS auf true: Session-Cookie wird nur verschluesselt uebertragen
COOKIE_SECURE=false

# Nur fuer den allerersten Start (Admin-Konto anlegen), danach wieder leeren.
# Passwort mindestens 12 Zeichen.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
